{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "nRF52840-DK",
            "type": "gdb",
            "request": "attach",
            "executable": "${workspaceRoot}/target/thumbv7em-none-eabi/release/nrf52840dk",
            "target": "localhost:2331",
            "remote": true,
            "cwd": "${workspaceRoot}",
            "gdbpath": "/usr/bin/gdb-multiarch",
            "autorun": [
                // "source ${workspaceFolder}/boards/nordic/nrf52840dk/jtag/gdbinit_pca10040.jlink",
                "monitor reset",
                "monitor speed auto",
                "b main"
            ]
        },
        {
            "name": "nRF5340-DK",
            "type": "gdb",
            "request": "attach",
            "executable": "${workspaceRoot}/target/thumbv8m.main-none-eabi/release/nrf5340dk",
            "target": "localhost:2331",
            "remote": true,
            "cwd": "${workspaceRoot}",
            "gdbpath": "/usr/bin/gdb-multiarch",
            "autorun": [
                // "source ${workspaceFolder}/boards/nordic/nrf52840dk/jtag/gdbinit_pca10040.jlink",
                "monitor reset",
                "monitor speed auto",
                "b main"
            ]
        }
    ]
}